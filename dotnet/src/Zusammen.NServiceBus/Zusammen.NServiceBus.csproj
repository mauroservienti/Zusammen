<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Zusammen.NServiceBus</PackageId>
    <Description>Lets NServiceBus endpoints consume messages sent by Zusammen (Node.js) without explicit .NET type mappings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NServiceBus" Version="[10.2.9, 11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zusammen.NServiceBus.Tests" />
  </ItemGroup>

</Project>
