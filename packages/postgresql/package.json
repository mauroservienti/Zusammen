{
  "name": "@zusammen/postgresql",
  "version": "0.0.0",
  "description": "PostgreSQL persistence for Zusammen transactional sessions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "@zusammen/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "@zusammen/source": "./src/drizzle/index.ts",
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./prisma": {
      "@zusammen/source": "./src/prisma/index.ts",
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    },
    "./sequelize": {
      "@zusammen/source": "./src/sequelize/index.ts",
      "types": "./dist/sequelize/index.d.ts",
      "default": "./dist/sequelize/index.js"
    },
    "./typeorm": {
      "@zusammen/source": "./src/typeorm/index.ts",
      "types": "./dist/typeorm/index.d.ts",
      "default": "./dist/typeorm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prisma:generate": "prisma generate --schema test/prisma/schema.prisma"
  },
  "dependencies": {},
  "peerDependencies": {
    "@zusammen/core": "workspace:^",
    "drizzle-orm": ">=0.45.0",
    "pg": "^8.11.0",
    "sequelize": "^6.37.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "@zusammen/core": "workspace:^",
    "@zusammen/testing": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "prisma": "7.10.1",
    "sequelize": "^6.37.8",
    "testcontainers": "^12.2.0",
    "typeorm": "^1.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauroservienti/Zusammen.git",
    "directory": "packages/postgresql"
  }
}
