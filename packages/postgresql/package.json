    "@types/pg": "^8.23.1",
    "@zusammen/core": "workspace:^",
    "@zusammen/testing": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.0"
